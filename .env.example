# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Public URL of the live site (share cards, sitemap, structured data).
# Optional on Vercel: falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Phase 2: not used by the landing page yet. Listed so the names are settled.
# ---------------------------------------------------------------------------

# Stripe: online checkout + payment webhooks
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio: "order received / ready" text messages
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Mailchimp: email list sign-ups
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=
# MAILCHIMP_AUDIENCE_ID=

# Optional, local only: Gemini (Nano Banana) for generating brand imagery
# GEMINI_API_KEY=
